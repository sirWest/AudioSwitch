<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Keep dotnet test and IDE discovery on the existing VSTest runner. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <ProjectReference Include="../AudioSwitch.Core/AudioSwitch.Core.csproj" />
    <ProjectReference Include="../AudioSwitch/AudioSwitch.csproj" />
    <ProjectReference
      Include="../AudioSwitch.Cli/AudioSwitch.Cli.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
