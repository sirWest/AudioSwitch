<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:AudioSwitch.Settings"
  x:Class="AudioSwitch.Settings.HotkeyEditorWindow"
  x:ClassModifier="internal"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  UseLayoutRounding="True"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
>
  <Window.Resources>
    <Style x:Key="ChoiceItem" TargetType="ComboBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="ToolTip" Value="{Binding Label}" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock
        x:Name="warning"
        TextWrapping="Wrap"
        Margin="0,6,0,0"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
      />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Click="CancelClick"
          Content="Cancel"
          IsCancel="True"
          MinWidth="78"
          Margin="3"
          Padding="10,5"
          HorizontalAlignment="Left"
        />
        <Button
          Click="SaveClick"
          Content="Save"
          MinWidth="78"
          Margin="3"
          Padding="10,5"
          HorizontalAlignment="Left"
        />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="deviceColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock
            Text="Name (optional)"
            TextWrapping="Wrap"
            FontWeight="SemiBold"
            Margin="0,8,0,4"
          />
          <TextBox x:Name="name" MaxLength="100" AutomationProperties.Name="Name (optional)" />
          <TextBlock Text="Action" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
          <ComboBox
            x:Name="action"
            SelectionChanged="ActionChanged"
            ItemContainerStyle="{StaticResource ChoiceItem}"
            AutomationProperties.Name="Action"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,4"
            DisplayMemberPath="Label"
            SelectedValuePath="Value"
          />
          <TextBlock Text="Shortcut" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,4" />
          <TextBox
            x:Name="capture"
            PreviewKeyDown="CaptureKeyDown"
            IsReadOnly="True"
            Padding="8"
            ToolTip="Press a key combination"
            AutomationProperties.Name="Shortcut"
          />
          <CheckBox
            Content="Show OSD"
            IsChecked="{Binding ShowOsd}"
            MinHeight="24"
            Padding="8,0,0,0"
            Margin="0,2"
          />
          <CheckBox
            x:Name="communications"
            IsChecked="{Binding AlsoCommunications}"
            MinHeight="24"
            Padding="8,0,0,0"
            Margin="0,2"
            AutomationProperties.Name="Also change the communications default"
          >
            <TextBlock Text="Also change the communications default" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
        <StackPanel x:Name="devices" Grid.Column="1" Margin="24,0,12,0">
          <local:HotkeyDeviceEditor x:Name="playback" />
          <local:HotkeyDeviceEditor x:Name="recording" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
