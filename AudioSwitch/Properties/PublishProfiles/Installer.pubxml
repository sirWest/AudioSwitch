<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <_InstallerPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'artifacts', 'publish', 'win-x64'))</_InstallerPublishDirectory>
    <PublishDir>$(_InstallerPublishDirectory)</PublishDir>
    <PublishUrl>$(_InstallerPublishDirectory)</PublishUrl>
  </PropertyGroup>

  <Target Name="PrepareInstallerPayload" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(Configuration)' != 'Release' or '$(RuntimeIdentifier)' != 'win-x64' or '$(SelfContained)' != 'false'"
           Text="The Installer profile requires Release, win-x64, and SelfContained=false." />
    <Error Condition="$([MSBuild]::NormalizeDirectory('$(PublishDir)')) != '$(_InstallerPublishDirectory)'"
           Text="The Installer profile publishes to artifacts/publish/win-x64. Do not override its output directory." />
    <!-- Clean only this profile's fixed package directory, before the SDK copies the app. -->
    <RemoveDir Directories="$(_InstallerPublishDirectory)" />
  </Target>

  <Target Name="BuildInstaller" AfterTargets="Publish">
    <!-- Complete the payload without publishing the app again or re-entering this profile. -->
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Publish.ps1&quot; -SkipAppPublish -BuildInstaller" />
  </Target>
</Project>
