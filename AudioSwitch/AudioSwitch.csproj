<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Setup/AudioSwitchIcon.ico</ApplicationIcon>
    <Description>AudioSwitch tray application</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AudioSwitch.Tests" />
    <ProjectReference Include="../AudioSwitch.Core/AudioSwitch.Core.csproj" />
    <Content
      Include="Skins/**/*.png;Skins/**/*.xml"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Resource Include="Assets/*.png" />
    <Resource Include="../Setup/AudioSwitchIcon.ico" Link="Assets/AudioSwitchIcon.ico" />
  </ItemGroup>
  <Target
    Name="GenerateVersionedApplicationManifest"
    BeforeTargets="_SetEmbeddedWin32ManifestProperties"
    DependsOnTargets="GetAssemblyVersion"
    Inputs="app.manifest;$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)../Directory.Build.props"
    Outputs="$(IntermediateOutputPath)app.$(AssemblyVersion).manifest"
  >
    <PropertyGroup>
      <ApplicationManifest>$(IntermediateOutputPath)app.$(AssemblyVersion).manifest</ApplicationManifest>
    </PropertyGroup>
    <Copy SourceFiles="app.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke
      XmlInputPath="$(ApplicationManifest)"
      Query="/asm:assembly/asm:assemblyIdentity/@version"
      Namespaces="&lt;Namespace Prefix='asm' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;"
      Value="$(AssemblyVersion)"
    />
    <ItemGroup>
      <FileWrites Include="$(ApplicationManifest)" />
    </ItemGroup>
  </Target>
</Project>
