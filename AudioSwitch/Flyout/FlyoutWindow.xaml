<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:AudioSwitch.Flyout"
  x:Class="AudioSwitch.Flyout.FlyoutWindow"
  x:ClassModifier="internal"
  PreviewMouseWheel="WindowPreviewMouseWheel"
  SourceInitialized="WindowSourceInitialized"
  ContentRendered="WindowContentRendered"
  KeyDown="WindowKeyDown"
  Deactivated="WindowDeactivated"
  IsVisibleChanged="WindowIsVisibleChanged"
  Title="AudioSwitch"
  Width="280"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStyle="None"
  ShowInTaskbar="False"
  Topmost="True"
  UseLayoutRounding="True"
  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
>
  <Window.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
      <!--Translucent surfaces placed over the Windows Acrylic backdrop.

        Top = lighter device-selection area.
        Bottom = darker volume / VU area.-->
      <SolidColorBrush
        x:Key="FlyoutTopSurfaceBrush"
        Color="{DynamicResource SolidBackgroundFillColorBase}"
        Opacity="0.45"
      />
      <SolidColorBrush
        x:Key="FlyoutBottomSurfaceBrush"
        Color="{DynamicResource SolidBackgroundFillColorSecondary}"
        Opacity="0.627451"
      />
      <!--Device list item-->
      <Style x:Key="CompactDeviceItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border
                x:Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="{TemplateBinding Padding}"
                CornerRadius="4"
                SnapsToDevicePixels="True"
              >
                <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"
                />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter
                    TargetName="Surface"
                    Property="Background"
                    Value="{DynamicResource SubtleFillColorSecondaryBrush}"
                  />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!--Invisible slider track buttons-->
      <Style x:Key="FaderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!--Volume slider-->
      <Style x:Key="AudioVolumeSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <!-- Keep the odd-height cap and tick pattern on the same centerline at fractional DPI. -->
              <Grid Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
                <!--Background tick/fader pattern-->
                <Rectangle Height="7" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Rectangle.Fill>
                    <DrawingBrush
                      TileMode="Tile"
                      Viewport="0,0,7,7"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,7,7"
                      ViewboxUnits="Absolute"
                      Stretch="None"
                    >
                      <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#808080" Geometry="M 0,0 L 1,0 1,7 0,7 Z" />
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <Track
                  x:Name="PART_Track"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Height="16"
                >
                  <Track.DecreaseRepeatButton>
                    <RepeatButton
                      Command="Slider.DecreaseLarge"
                      Style="{StaticResource FaderTrackButton}"
                    />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="31" Height="16" Cursor="Hand" FocusVisualStyle="{x:Null}">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent">
                            <local:VolumeThumb x:Name="Cap" Height="9" VerticalAlignment="Center" />
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Cap" Property="Active" Value="True" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Cap" Property="Active" Value="True" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton
                      Command="Slider.IncreaseLarge"
                      Style="{StaticResource FaderTrackButton}"
                    />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="GroupHeadingTemplate">
        <DockPanel>
          <Button
            DockPanel.Dock="Right"
            Content="&#x2699;"
            ToolTip="Settings"
            Width="26"
            Height="24"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="SettingsClick"
          >
            <Button.Visibility>
              <Binding Path="ShowSettings" Converter="{StaticResource BooleanVisibility}" />
            </Button.Visibility>
          </Button>
          <TextBlock
            Text="{Binding Name}"
            FontSize="12"
            FontWeight="SemiBold"
            Margin="3,6,0,3"
            IsHitTestVisible="False"
          />
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="DeviceRowTemplate">
        <Grid MinHeight="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="32" Height="32">
            <Image Source="{Binding Icon}" Width="32" Height="32" />
            <Grid
              Width="15"
              Height="15"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,-1,-1"
              IsHitTestVisible="False"
              SnapsToDevicePixels="False"
              UseLayoutRounding="False"
            >
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Ellipse Fill="{DynamicResource {x:Static SystemColors.AccentColorLight2BrushKey}}" />
              <Ellipse Fill="Transparent" Stroke="#4B000000" StrokeThickness="1" />
              <Path
                Data="M 0,3.6 L 3.2,6.7 L 9.2,0"
                Width="9.2"
                Height="6.7"
                Stretch="Fill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stroke="White"
                StrokeThickness="1.9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                SnapsToDevicePixels="False"
              />
            </Grid>
          </Grid>
          <TextBlock
            Grid.Column="1"
            Text="{Binding Name}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            Margin="3,0,0,0"
          />
        </Grid>
      </DataTemplate>
      <Style
        x:Key="FlyoutRowStyle"
        TargetType="ListBoxItem"
        BasedOn="{StaticResource CompactDeviceItem}"
      >
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="ToolTip" Value="{Binding Device.Name}" />
        <Setter Property="ContentTemplate" Value="{StaticResource DeviceRowTemplate}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsHeading}" Value="True">
            <Setter Property="ContentTemplate" Value="{StaticResource GroupHeadingTemplate}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsEmpty}" Value="True">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="Transparent">
    <DockPanel Background="Transparent">
      <Border
        DockPanel.Dock="Bottom"
        Padding="18,12,18,14"
        Background="{DynamicResource FlyoutBottomSurfaceBrush}"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="16" />
            <RowDefinition Height="4" />
          </Grid.RowDefinitions>
          <local:VuMeter x:Name="leftMeter" Height="4" />
          <Slider
            x:Name="volumeSlider"
            MouseRightButtonUp="VolumeSliderMouseRightButtonUp"
            ValueChanged="VolumeSliderValueChanged"
            Grid.Row="1"
            Minimum="0"
            Maximum="1"
            SmallChange="0.02"
            LargeChange="0.1"
            Style="{StaticResource AudioVolumeSlider}"
          />
          <local:VuMeter x:Name="rightMeter" Grid.Row="2" Height="4" />
        </Grid>
      </Border>
      <Border Padding="8" Background="{DynamicResource FlyoutTopSurfaceBrush}">
        <Grid Background="Transparent">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel x:Name="header" Margin="0,0,0,3">
            <Button
              DockPanel.Dock="Right"
              Content="&#x2699;"
              ToolTip="Settings"
              Width="26"
              Height="24"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Click="SettingsClick"
            />
            <TextBlock
              x:Name="title"
              MouseLeftButtonDown="TitleMouseLeftButtonDown"
              Margin="5"
              FontSize="12"
            />
          </DockPanel>
          <ListBox
            x:Name="deviceList"
            KeyDown="DeviceListKeyDown"
            PreviewMouseLeftButtonUp="DeviceListPreviewMouseLeftButtonUp"
            PreviewMouseMove="DeviceListPreviewMouseMove"
            PreviewMouseLeftButtonDown="DeviceListPreviewMouseLeftButtonDown"
            Grid.Row="1"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            MaxHeight="430"
            FocusVisualStyle="{x:Null}"
            Background="Transparent"
            Padding="0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ItemContainerStyle="{StaticResource FlyoutRowStyle}"
          />
        </Grid>
      </Border>
    </DockPanel>
  </Border>
</Window>
